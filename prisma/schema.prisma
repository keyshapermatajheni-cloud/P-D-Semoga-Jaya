generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Barang {
  id_barang           String                @id @db.VarChar(10)
  nama_barang         String                @db.VarChar(100)
  satuan              String                @db.VarChar(20)
  harga_beli          Decimal               @db.Decimal(12, 2)
  harga_jual          Decimal               @db.Decimal(12, 2)
  stok_gudang         Int
  stok_display        Int
  stok_minimum        Int
  Detail_Barang_Masuk Detail_Barang_Masuk[]
  Detail_Laporan      Detail_Laporan[]
  Detail_Pemesanan    Detail_Pemesanan[]
  Detail_Transaksi    Detail_Transaksi[]
  Penyesuaian_Stok    Penyesuaian_Stok[]
}

model Barang_Masuk {
  id_barang_masuk     String                @id @db.VarChar(25)
  tgl_penerima        DateTime              @db.Date
  status_periksa      String                @db.VarChar(15)
  id_pemesanan        String                @db.VarChar(25)
  id_pengguna         String                @db.VarChar(10)
  Pemesanan_Barang    Pemesanan_Barang      @relation(fields: [id_pemesanan], references: [id_pemesanan], map: "fk_barang_masuk_pemesanan")
  Pengguna            Pengguna              @relation(fields: [id_pengguna], references: [id_pengguna], map: "fk_barang_masuk_pengguna")
  Detail_Barang_Masuk Detail_Barang_Masuk[]

  @@index([id_pemesanan], map: "idx_barang_masuk_pemesanan")
  @@index([id_pengguna], map: "idx_barang_masuk_pengguna")
}

model Detail_Barang_Masuk {
  id_detail_barang_masuk String       @id @db.VarChar(10)
  jumlah_dikirim         Int
  jumlah_diterima        Int
  id_barang              String       @db.VarChar(10)
  id_barang_masuk        String       @db.VarChar(25)
  Barang                 Barang       @relation(fields: [id_barang], references: [id_barang], map: "fk_detail_barang_masuk_barang")
  Barang_Masuk           Barang_Masuk @relation(fields: [id_barang_masuk], references: [id_barang_masuk], map: "fk_detail_barang_masuk_header")

  @@index([id_barang], map: "idx_detail_barang_masuk_barang")
  @@index([id_barang_masuk], map: "idx_detail_barang_masuk_header")
}

model Detail_Laporan {
  id_detail_laporan  String             @id @db.VarChar(10)
  jumlah_masuk       Int
  jumlah_keluar      Int
  stok_akhir         Int
  id_laporan         String             @db.VarChar(25)
  id_barang          String             @db.VarChar(10)
  Barang             Barang             @relation(fields: [id_barang], references: [id_barang], map: "fk_detail_laporan_barang")
  Laporan_Persediaan Laporan_Persediaan @relation(fields: [id_laporan], references: [id_laporan], map: "fk_detail_laporan_laporan")

  @@index([id_barang], map: "idx_detail_laporan_barang")
  @@index([id_laporan], map: "idx_detail_laporan_laporan")
}

model Detail_Pemesanan {
  id_detail_pemesanan String          @id @db.VarChar(10)
  jumlah_dipesan    Int
  id_barang         String           @db.VarChar(10)
  id_pemesanan      String           @db.VarChar(25)
  Barang            Barang           @relation(fields: [id_barang], references: [id_barang], map: "fk_detail_pemesanan_barang")
  Pemesanan_Barang  Pemesanan_Barang @relation(fields: [id_pemesanan], references: [id_pemesanan], map: "fk_detail_pemesanan_pemesanan")

  @@index([id_barang], map: "idx_detail_pemesanan_barang")
  @@index([id_pemesanan], map: "idx_detail_pemesanan_pemesanan")
}

model Detail_Transaksi {
  id_detail_transaksi String              @id @db.VarChar(10)
  jumlah              Int
  harga_satuan        Decimal             @db.Decimal(12, 2)
  id_transaksi        String              @db.VarChar(25)
  id_barang           String              @db.VarChar(10)
  Barang              Barang              @relation(fields: [id_barang], references: [id_barang], map: "fk_detail_transaksi_barang")
  Transaksi_Penjualan Transaksi_Penjualan @relation(fields: [id_transaksi], references: [id_transaksi], map: "fk_detail_transaksi_transaksi")

  @@index([id_barang], map: "idx_detail_transaksi_barang")
  @@index([id_transaksi], map: "idx_detail_transaksi_transaksi")
}

model Laporan_Persediaan {
  id_laporan     String           @id @db.VarChar(25)
  tgl_laporan    DateTime         @db.Date
  periode_awal   DateTime         @db.Date
  periode_akhir  DateTime         @db.Date
  id_pengguna    String           @db.VarChar(10)
  Detail_Laporan Detail_Laporan[]
  Pengguna       Pengguna         @relation(fields: [id_pengguna], references: [id_pengguna], map: "fk_laporan_pengguna")

  @@index([id_pengguna], map: "idx_laporan_pengguna")
}

model Pemesanan_Barang {
  id_pemesanan     String             @id @db.VarChar(25)
  tgl_pemesanan    DateTime           @db.Date
  status_pemesanan String             @db.VarChar(20)
  id_pengguna      String             @db.VarChar(10)
  id_supplier      String             @db.VarChar(10)
  Barang_Masuk     Barang_Masuk[]
  Detail_Pemesanan Detail_Pemesanan[]
  Pengguna         Pengguna           @relation(fields: [id_pengguna], references: [id_pengguna], map: "fk_pemesanan_pengguna")
  Supplier         Supplier           @relation(fields: [id_supplier], references: [id_supplier], map: "fk_pemesanan_supplier")

  @@index([id_pengguna], map: "idx_pemesanan_pengguna")
  @@index([id_supplier], map: "idx_pemesanan_supplier")
}

model Pengguna {
  id_pengguna         String                @id @db.VarChar(10)
  nama_pengguna       String                @db.VarChar(100)
  username            String                @db.VarChar(50)
  password            String                @db.VarChar(255)
  role                String                @db.VarChar(20)
  Barang_Masuk        Barang_Masuk[]
  Laporan_Persediaan  Laporan_Persediaan[]
  Pemesanan_Barang    Pemesanan_Barang[]
  Penyesuaian_Stok    Penyesuaian_Stok[]
  Transaksi_Penjualan Transaksi_Penjualan[]
}

model Penyesuaian_Stok {
  id_penyesuaian String   @id @db.VarChar(25)
  tanggal        DateTime @db.Date
  jenis          String   @db.VarChar(20)
  jumlah         Int
  id_barang      String   @db.VarChar(10)
  id_pengguna    String   @db.VarChar(10)
  Barang         Barang   @relation(fields: [id_barang], references: [id_barang], map: "fk_penyesuaian_barang")
  Pengguna       Pengguna @relation(fields: [id_pengguna], references: [id_pengguna], map: "fk_penyesuaian_pengguna")

  @@index([id_barang], map: "idx_penyesuaian_barang")
  @@index([id_pengguna], map: "idx_penyesuaian_pengguna")
}

model Supplier {
  id_supplier      String             @id @db.VarChar(10)
  nama_supplier    String             @db.VarChar(100)
  alamat           String             @db.VarChar(255)
  no_telepon       String             @db.VarChar(15)
  Pemesanan_Barang Pemesanan_Barang[]
}

model Transaksi_Penjualan {
  id_transaksi     String             @id @db.VarChar(25)
  tgl_transaksi    DateTime           @db.Date
  id_pengguna      String             @db.VarChar(10)
  Detail_Transaksi Detail_Transaksi[]
  Pengguna         Pengguna           @relation(fields: [id_pengguna], references: [id_pengguna], map: "fk_transaksi_pengguna")

  @@index([id_pengguna], map: "idx_transaksi_pengguna")
}
